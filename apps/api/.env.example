# App
APP_PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=store_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=48h

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=store-media
# Public host used to build presigned URLs (browsers can't reach the internal
# `minio:9000`). Leave empty in dev — the internal host is fine there. In
# prod set to your CDN, e.g. storage.elinaclothes.com, and the CDN must
# preserve the original `Host` header when forwarding to MinIO (SigV4).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=true

# OTP
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=90
OTP_MAX_REQUESTS_PER_HOUR=5

# Kavenegar SMS provider. Empty API key = dev mode (OTP logged, no SMS).
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=otp-elina
KAVENEGAR_ORDER_CREATED_TEMPLATE=order-created-elina

# Cod24 shipping aggregator (Iran Post + Tipax + others). Leave empty in dev
# — Cod24Service is not wired into any flow yet, so nothing will call it.
COD24_BASE_URL=https://api.cod24.ir/api
COD24_USERNAME=
COD24_PASSWORD=
COD24_TIMEOUT_MS=30000
COD24_TOKEN_TTL_SECONDS=3300
COD24_STATE_CACHE_TTL_SECONDS=604800

# Public URLs (used by payment gateway callbacks)
WEB_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000

# ZarinPal
ZARINPAL_MERCHANT_ID=
ZARINPAL_CURRENCY=IRT
ZARINPAL_SANDBOX=false
